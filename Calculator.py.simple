print("Simple Calculator")

num1= float(input("Enter first number: "))
num2= float(input("Enter second number: "))

print("Choose operation")
print("1. +")
print("2. -")
print("3. /")
print("4. *")

choice = input("Enter choice (1-4): ")

if choice == "1":
      print(num1 + num2)
  elif choice == "2":
      print(num1 - num2)
  elif choice == "4":
      print(num1 - num2)
  elif choice == "3":
    if num2 != 0:
      print(num1 / num2)
    else:
      print("Error 1")
else:
    print("Calculating Error")
